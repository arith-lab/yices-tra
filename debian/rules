#!/usr/bin/make -f

#export DH_VERBOSE = 1

%:
	dh $@ --with autoreconf

override_dh_auto_configure:
	dh_auto_configure -- --prefix=/usr --host=$(DEB_HOST_MULTIARCH)

override_dh_auto_build:
	$(MAKE) CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" STRIP=echo ARCH=$(DEB_HOST_MULTIARCH)

# The regression tests of YicesTRA (tests/regress/mcsat/tra), skipped under DEB_BUILD_OPTIONS=nocheck
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) CFLAGS="$(CFLAGS)" LDFLAGS="$(LDFLAGS)" ARCH=$(DEB_HOST_MULTIARCH) tra-regress
else
	@echo "nocheck: the regression tests are skipped"
endif

# Installs ytra only
override_dh_auto_install:
	$(MAKE) DESTDIR=$$(pwd)/debian/tmp/ prefix=/usr ARCH=$(DEB_HOST_MULTIARCH) install

override_dh_clean:
	rm -rf build
	dh_clean

override_dh_auto_clean:
	@echo "overriding auto clean"

; reset-assertions with open scopes.
(set-logic QF_TRA)
(declare-fun x () Real)
(push 1)
(assert (> (exp x) 2))
(check-sat)
(push 1)
(assert (< (sin x) 0))
(check-sat)
(reset-assertions)
(declare-fun y () Real)
(assert (< (exp 1) 2.7))
(check-sat)
(reset-assertions)
(declare-fun z () Real)
(assert (> (sin z) 0.5))
(assert (< z 1))
(check-sat)
(push 1)
(assert (< z 0.5))
(check-sat)
(pop 1)
(check-sat)

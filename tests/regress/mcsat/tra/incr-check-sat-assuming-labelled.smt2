; Repeated check-sat-assuming on the labelled path (produce-unsat-assumptions).
(set-option :produce-unsat-assumptions true)
(set-logic QF_TRA)
(declare-fun x () Real)
(declare-fun a () Bool)
(declare-fun b () Bool)
(assert (=> a (> (exp x) 10)))
(assert (=> b (< x 2)))
(check-sat-assuming (a b))
(get-unsat-assumptions)
(check-sat-assuming (a))
(check-sat-assuming (b))
(check-sat-assuming (a b))
(check-sat)

; Models across push and pop.
(set-option :produce-models true)
(set-logic QF_TRA)
(declare-fun x () Real)
(declare-fun y () Real)
(push 1)
(assert (> (exp x) 10))
(assert (< x 2))
(check-sat)
(pop 1)
(assert (>= (* 2 x) 1))
(assert (<= (* 2 x) 1))
(assert (> (sin x) 0.4))
(check-sat)
(get-model)
(push 1)
(assert (= y (+ x 1)))
(check-sat)
(get-model)
(pop 1)
(check-sat)
(get-model)

; A chain of nonlinear definitions a_k = 1 + a_(k-1)^2. Substituting the definitions into
; z - a15 one after the other doubles the degree at every link (degree 2^15 in x). NA does not
; substitute a nonlinear definition when the total degree would exceed twice the original one.
; Unsat: a1 >= 1, hence a_k >= 1 for every k, and z > a15 >= 1 > z.
(set-logic QF_NRA)
(declare-fun x () Real)
(declare-fun z () Real)
(declare-fun a1 () Real)
(declare-fun a2 () Real)
(declare-fun a3 () Real)
(declare-fun a4 () Real)
(declare-fun a5 () Real)
(declare-fun a6 () Real)
(declare-fun a7 () Real)
(declare-fun a8 () Real)
(declare-fun a9 () Real)
(declare-fun a10 () Real)
(declare-fun a11 () Real)
(declare-fun a12 () Real)
(declare-fun a13 () Real)
(declare-fun a14 () Real)
(declare-fun a15 () Real)
(assert (= a1 (+ 1 (* x x))))
(assert (= a2 (+ 1 (* a1 a1))))
(assert (= a3 (+ 1 (* a2 a2))))
(assert (= a4 (+ 1 (* a3 a3))))
(assert (= a5 (+ 1 (* a4 a4))))
(assert (= a6 (+ 1 (* a5 a5))))
(assert (= a7 (+ 1 (* a6 a6))))
(assert (= a8 (+ 1 (* a7 a7))))
(assert (= a9 (+ 1 (* a8 a8))))
(assert (= a10 (+ 1 (* a9 a9))))
(assert (= a11 (+ 1 (* a10 a10))))
(assert (= a12 (+ 1 (* a11 a11))))
(assert (= a13 (+ 1 (* a12 a12))))
(assert (= a14 (+ 1 (* a13 a13))))
(assert (= a15 (+ 1 (* a14 a14))))
(assert (> z a15))
(assert (< z 1))
(check-sat)

; Satisfiable variant of na-def-c1-poly-div; the model is checked by hand: A = B = -1/4, C = 0.
(set-logic QF_NRA)
(declare-fun n () Real)
(declare-fun r () Real)
(declare-fun A () Real)
(declare-fun B () Real)
(declare-fun C () Real)
(assert (>= n 2))
(assert (<= (* r r) (* n (- n 1))))
(assert (= A (- (/ (* (- r 1) (- r 1)) (* 2 (- n 1))))))
(assert (= B (- (/ (* (+ r 1) (+ r 1)) (* 2 (- n 1))))))
(assert (= C (- (/ (* r r) (* 2 n)))))
(assert (> (- C (/ (+ A B) 2) (/ (* (- A B) (- A B)) 8)) 0))
(assert (< r 1))
(check-sat)
(get-value (n r A B C))
